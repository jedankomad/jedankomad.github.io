---
layout: null
---
{
"movies": [{% for m in site.data.movies %}
{"t":{{ m.title | jsonify }},"y":{{ m.year | jsonify }},"r":{{ m.rating | jsonify }},"d":{{ m.watched | jsonify }},"l":{{ m.link | jsonify }},"p":{{ m.poster | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
],
"games": [{% for g in site.data.games %}
{"t":{{ g.title | jsonify }},"y":{{ g.year | jsonify }},"s":{{ g.studio | jsonify }},"a":{{ g.appid | jsonify }},"c":{% if g.cover %}{{ g.cover | relative_url | jsonify }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}
],
"posts": [{% for post in site.posts %}
{"t":{{ post.title | strip_html | jsonify }},"s":{{ post.subtitle | strip_html | jsonify }},"u":{{ post.url | relative_url | jsonify }},"d":{{ post.date | date: "%Y-%m-%d" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
],
"pages": [{% assign pages = site.html_pages | where_exp: "p", "p.title" %}{% for page in pages %}{% unless page.title == "404 - Page not found" or page.url == "/" %}
{"t":{{ page.title | strip_html | jsonify }},"s":{{ page.subtitle | strip_html | jsonify }},"u":{{ page.url | relative_url | jsonify }}},{% endunless %}{% endfor %}
{"t":"Početna","s":{{ site.title | jsonify }},"u":{{ "/" | relative_url | jsonify }}}
]
}
